{
  "name": "feed-forward-desktop",
  "version": "0.1.3",
  "description": "Private practice feedback on assignment drafts — open an instructor rubric, use your own model endpoint, keep everything on your machine.",
  "author": {
    "name": "Michael Borck",
    "email": "michael@borck.dev"
  },
  "license": "MIT",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --config electron-builder.config.js",
    "typecheck": "tsc --noEmit",
    "fetch:uv": "node scripts/fetch-uv.mjs",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "test": "vitest run",
    "smoke:sidecar": "scripts/smoke-sidecar.sh"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.65.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.8"
  }
}
